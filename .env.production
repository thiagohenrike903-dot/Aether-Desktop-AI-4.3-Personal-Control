# Aether Desktop AI — Vercel environment variables
# Set these in Vercel Project Settings > Environment Variables

# --- LLM Provider ---
LLM_PROVIDER="gemini"

# --- Google Gemini API Key ---
GEMINI_API_KEY="your-gemini-api-key-here"

# --- LLM (OpenAI-compatible) ---
# LLM_API_KEY=""
# LLM_BASE_URL=""
# LLM_MODEL=""

# --- ElevenLabs TTS ---
# ELEVENLABS_API_KEY=""

# --- Weather ---
# WEATHER_API_KEY=""

# --- CORS allowed origins (comma-separated) ---
# AETHER_ALLOWED_ORIGINS="https://*.vercel.app,https://your-custom-domain.com"
