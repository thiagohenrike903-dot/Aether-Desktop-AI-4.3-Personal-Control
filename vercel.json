{
  "name": "aether-desktop-ai",
  "version": 2,
  "buildCommand": null,
  "installCommand": "pip install -r requirements-vercel.txt",
  "functions": {
    "api/index.py": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py" }
  ],
  "env": {
    "VERCEL": "1",
    "JARVIS_HOST": "0.0.0.0",
    "JARVIS_PORT": "8765",
    "AETHER_DESKTOP": "0"
  }
}
