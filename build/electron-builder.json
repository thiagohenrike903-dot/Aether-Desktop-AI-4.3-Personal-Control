{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "ai.aether.desktop",
  "productName": "Aether Desktop AI",
  "copyright": "© 2026 Aether",
  "protocols": [
    {
      "name": "Aether Desktop AI",
      "schemes": ["aether"]
    }
  ],
  "asar": true,
  "compression": "maximum",
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true,
    "loadBrowserProcessSpecificV8Snapshot": false,
    "grantFileProtocolExtraPrivileges": false
  },
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!electron/*.test.cjs",
    "package.json",
    "build/splash.html",
    "build/update-public-key.pem",
    "build/assets/aether-wordmark-transparent.png",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "docs/**/*",
    "!**/node_modules/**/test/**",
    "!**/node_modules/**/tests/**"
  ],
  "extraResources": [
    {
      "from": ".env.example",
      "to": ".env.example"
    },
    {
      "from": "build/icon.png",
      "to": "icon.png"
    },
    {
      "from": "build/tray",
      "to": "tray",
      "filter": [
        "*.png"
      ]
    },
    {
      "from": "python",
      "to": "python",
      "filter": [
        "**/*",
        "!**/.env*",
        "!**/__pycache__/**",
        "!**/*.pyc",
        "!**/.pytest_cache/**",
        "!**/.mypy_cache/**",
        "!**/.ruff_cache/**",
        "!**/*.egg-info/**",
        "!**/.coverage*",
        "!**/*credentials*.json",
        "!**/*secret*",
        "!**/*.pem",
        "!**/*.key",
        "!**/*.p12",
        "!**/*.pfx",
        "!jarvis_data/**",
        "!tests/**"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "Aether-Setup-${version}.${ext}"
  },
  "portable": {
    "artifactName": "Aether-Portable-${version}.${ext}",
    "splashImage": "build/portable-splash.bmp"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Aether Desktop AI",
    "include": "build/installer.nsh",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeader": "build/installerHeader.bmp",
    "installerSidebar": "build/installerSidebar.bmp",
    "uninstallerSidebar": "build/uninstallerSidebar.bmp",
    "uninstallDisplayName": "Aether Desktop AI",
    "deleteAppDataOnUninstall": false,
    "installerLanguages": ["pt_BR", "en_US"]
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "icon": "build/icon.png",
    "category": "Utility"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "build/icon.png",
    "category": "public.app-category.utilities"
  }
}
