# ---------------------------------------------------------------------------
# Aether Desktop AI — environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need.
# Never commit `.env` or paste real credentials into this example file.
# ---------------------------------------------------------------------------

# --- LLM Provider (choose ONE) ----------------------------------------------
# Supported providers: "gemini" | "glm" | "qwen" | "qwen_api" | "openai" | "ollama"
LLM_PROVIDER="gemini"

# --- Google Gemini ----------------------------------------------------------
# API key from https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
# Use a model currently supported by your provider account.
JARVIS_AGENT_MODEL="gemini-2.0-flash"

# --- GLM-4V (Zhipu AI) — VISION CAPABLE ------------------------------------
# API key from https://open.bigmodel.cn/
LLM_API_KEY=""
# When using GLM, set LLM_MODEL to a supported GLM model.
LLM_MODEL=""

# --- OpenAI-compatible (OpenAI, DeepSeek, Anthropic via API, etc.) ----------
# LLM_API_KEY="provider-key"
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_MODEL="your-model-name"

# --- Qwen-VL (via Ollama — LOCAL, VISION CAPABLE) --------------------------
# Install Ollama from https://ollama.com, then:
#   ollama pull qwen2.5-vl
# No API key needed.
# LLM_PROVIDER="qwen"
# LLM_MODEL="qwen2.5-vl"  # or qwen-vl, qwen2.5-vl:7b, qwen2.5-vl:72b

# --- Qwen-VL (via DashScope API — Alibaba Cloud) ---------------------------
# API key from https://bailian.console.aliyun.com/
# LLM_PROVIDER="qwen_api"
# LLM_API_KEY="provider-key"
# LLM_MODEL="qwen-vl-plus"  # qwen-vl-plus, qwen2.5-vl-72b-instruct, etc.

# --- Ollama (LOCAL LLMs, fully offline) -------------------------------------
# No API key needed. Install Ollama from https://ollama.com
# LLM_PROVIDER="ollama"
# OLLAMA_BASE_URL="http://localhost:11434"
# LLM_MODEL="llama3.2-vision"  # llava, llama3.2-vision, mistral, etc.

# --- ElevenLabs TTS ---------------------------------------------------------
# Used by the Python core for neural voice synthesis.
# If left blank, the assistant uses the local browser/Windows speech engine.
ELEVENLABS_API_KEY="your-elevenlabs-api-key-here"
ELEVENLABS_VOICE_ID="dX7gRq1dIvLTgUaWpEFn"

# --- Weather (optional) -----------------------------------------------------
# Create a dedicated OpenWeather key. Never reuse an LLM credential here.
WEATHER_API_KEY=""

# Optional IANA timezone for calendar events without an explicit UTC offset.
# Example: Asia/Bangkok, Europe/Lisbon, America/Sao_Paulo
AETHER_TIMEZONE=""

# --- Python service ---------------------------------------------------------
# Host/port used by direct Python development. During a desktop launch,
# Electron fixes these values to the same protected loopback connection.
JARVIS_HOST="127.0.0.1"
JARVIS_PORT=8765

# Optional: override the python executable the Electron main process spawns.
# Useful for virtualenvs.
# JARVIS_PYTHON="C:\\path\\to\\venv\\Scripts\\python.exe"

# --- Whisper (offline STT) --------------------------------------------------
# tiny | base | small | medium | large
JARVIS_WHISPER_MODEL="base"

# --- Computer vision --------------------------------------------------------
JARVIS_CV_ENABLED=1

# Optional: move local memory, tasks, plugins and backups to another directory.
# JARVIS_DATA_DIR="C:\\Users\\you\\AppData\\Roaming\\Aether\\data"
